  "2024-3-03": {
    "full": [
      {"type": "prose", "text": "다음 <employee>와 <project> 테이블을 참조하여 <SQL문>을 실행했을 때 출력되는 결과를 쓰시오. (5점)"},
      {
        "type": "table",
        "caption": "<employee>",
        "headers": ["no", "first_name", "last_name", "project_id"],
        "rows": [["1", "John", "Doe", "10"], ["2", "Jim", "Carry", "20"], ["3", "Rachel", "Redmond", "10"]]
      },
      {
        "type": "table",
        "caption": "<project>",
        "headers": ["project_id", "name"],
        "rows": [["10", "Alpha"], ["20", "Beta"], ["10", "Gamma"]]
      },
      {"type": "prose", "text": "<SQL문>"},
      {
        "type": "code",
        "language": "SQL",
        "text": "SELECT count(*)\nFROM employee AS e\nJOIN project AS p ON e.project_id = p.project_id\nWHERE p.name IN (\n    SELECT name\n    FROM project p\n    WHERE p.project_id IN (\n        SELECT project_id\n        FROM employee\n        GROUP BY project_id\n        HAVING count(*) < 2\n    )\n);"
      }
    ]
  },
